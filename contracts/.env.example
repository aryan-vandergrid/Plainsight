# Copy to contracts/.env and fill in. Never commit .env.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Deployer: registers plainsight.eth, deploys contracts, holds DEMO-ONLY ENS admin roles until renounceAdmin.
DEPLOYER_PK=0x...
# Issuer of the ABC / XYZ demo launches. Must be a different key from the deployer.
ISSUER_PK=0x...
# Optional: Etherscan key for --verify
ETHERSCAN_API_KEY=
